# GitHub Actions self-hosted runner — Windows ltsc2022 base
# ServerCore image for general workflows.
#
# No Chocolatey — all tools installed via direct download for reliability.
#
# This file is built on a Windows host by `./make build github-runner <version>`, which passes PWSH_VERSION, GIT_VERSION, and JQ_VERSION from config.yaml.

# Tool versions (pinned for reproducibility)
ARG PWSH_VERSION
ARG GIT_VERSION
ARG JQ_VERSION

# =============================================================================
# Stage: base — ServerCore (lightweight, direct install, no Chocolatey)
# =============================================================================
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS base

ARG VERSION
ARG PWSH_VERSION
ARG GIT_VERSION
ARG JQ_VERSION

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Validate required build args
RUN if (-not $env:PWSH_VERSION) { throw 'PWSH_VERSION is required' }; \
    if (-not $env:GIT_VERSION) { throw 'GIT_VERSION is required' }; \
    if (-not $env:JQ_VERSION) { throw 'JQ_VERSION is required' }

# Install PowerShell 7 via MSI
RUN Invoke-WebRequest -Uri ('https://github.com/PowerShell/PowerShell/releases/download/v' + $env:PWSH_VERSION + '/PowerShell-' + $env:PWSH_VERSION + '-win-x64.msi') -OutFile C:\pwsh.msi; \
    $installer = Start-Process -Wait -PassThru -FilePath msiexec.exe -ArgumentList '/i', 'C:\pwsh.msi', '/quiet', '/norestart'; \
    # 3010 is a successful install awaiting reboot; /norestart prevents reboot-initiated 1641. \
    if ($installer.ExitCode -notin 0, 3010) { throw ('PowerShell MSI failed with exit code ' + $installer.ExitCode) }; \
    Remove-Item C:\pwsh.msi -Force

# Install Git for Windows
RUN $p = $env:GIT_VERSION -split '\.windows\.'; \
    $num = $p[0]; \
    $rev = if ($p.Length -gt 1) { $p[1] } else { '1' }; \
    $suf = if ($rev -eq '1') { '' } else { '.' + $rev }; \
    Invoke-WebRequest -Uri ('https://github.com/git-for-windows/git/releases/download/v' + $env:GIT_VERSION + '/Git-' + $num + $suf + '-64-bit.exe') -OutFile C:\git-installer.exe; \
    $installer = Start-Process -Wait -PassThru -FilePath C:\git-installer.exe -ArgumentList '/VERYSILENT', '/NORESTART', '/NOCANCEL', '/SP-', '/CLOSEAPPLICATIONS', '/RESTARTAPPLICATIONS', '/COMPONENTS=ext,ext\shellhere,ext\guihere,gitlfs,assoc,assoc_sh'; \
    # Inno Setup documents 0 as the only completed-install exit code. \
    if ($installer.ExitCode -ne 0) { throw ('Git for Windows installer failed with exit code ' + $installer.ExitCode) }; \
    Remove-Item C:\git-installer.exe -Force

# Install jq
RUN Invoke-WebRequest -Uri ('https://github.com/jqlang/jq/releases/download/jq-' + $env:JQ_VERSION + '/jq-windows-amd64.exe') -OutFile 'C:\Windows\System32\jq.exe'

SHELL ["pwsh", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Add tools to PATH + enable long paths
RUN $machPath = [System.Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    [System.Environment]::SetEnvironmentVariable('Path', ($machPath + ';C:\Program Files\Git\bin;C:\Program Files\Git\cmd'), 'Machine'); \
    Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' -Name 'LongPathsEnabled' -Value 1; \
    $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); \
    git config --system core.longpaths true

ENV RUNNER_DISABLE_AUTO_UPDATE=1

# Create user
RUN net user runneradmin /add /Y; \
    net localgroup administrators runneradmin /add

WORKDIR C:\\actions-runner

# Runner agent
COPY runner.zip runner.zip
RUN Expand-Archive -Path runner.zip -DestinationPath . -Force; \
    Remove-Item runner.zip

COPY entrypoint.ps1 C:\\entrypoint.ps1

LABEL org.opencontainers.image.description="GitHub Actions self-hosted runner (Windows ltsc2022)"
LABEL org.opencontainers.image.source="https://github.com/oorabona/docker-containers"
LABEL com.github.runner.version="${VERSION}"
LABEL com.github.runner.flavor="base"
LABEL com.github.runner.distro="windows-ltsc2022"

USER runneradmin
ENTRYPOINT ["pwsh", "-File", "C:\\entrypoint.ps1"]
